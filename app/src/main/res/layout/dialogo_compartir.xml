<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo "Compartir lista": código, enviar/copiar, miembros y opciones -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/txtCompartirExplicacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- El código, grande y fácil de leer -->
        <TextView
            android:id="@+id/txtCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_codigo"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:text="K7P 2QX"
            android:textColor="@color/primary_dark"
            android:textIsSelectable="true"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Sin O, 0, I, L ni 1 para que no haya confusiones"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Copiar / Enviar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopiarCodigo"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:letterSpacing="0"
                android:text="Copiar"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                app:cornerRadius="14dp"
                app:strokeColor="@color/primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnviarCodigo"
                style="@style/Widget.LlistaCompra.BotonPrincipal"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Enviar"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_share"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/white" />
        </LinearLayout>

        <!-- Miembros -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="En esta lista"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtMiembros"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <!-- Opciones -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/divider" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCambiarNombre"
            style="@style/Widget.LlistaCompra.BotonTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cambiar nombre de la lista" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegenerarCodigo"
            style="@style/Widget.LlistaCompra.BotonTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generar código nuevo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSalirLista"
            style="@style/Widget.LlistaCompra.BotonTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salir de la lista"
            android:textColor="@color/peligro" />
    </LinearLayout>
</ScrollView>
