<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompatActivity + componentes Material necesitan un tema MaterialComponents.
         NoActionBar porque la cabecera ya está dibujada en activity_main.xml -->
    <style name="Theme.LlistaCompra" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/purple_500</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/purple_700</item>
    </style>
</resources>